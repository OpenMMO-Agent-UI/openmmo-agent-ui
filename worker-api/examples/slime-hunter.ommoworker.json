{
  "format": "openmmo-worker",
  "version": 1,
  "metadata": {
    "name": "Slime Hunter",
    "description": "Uses a potion when hurt, otherwise attacks the nearest Slime."
  },
  "rules": [
    {
      "id": "heal",
      "priority": 100,
      "condition": {
        "all": [
          { "lt": [{ "ref": "self.health_pct" }, 30] },
          { "gt": [{ "count": { "select": "bag", "where": { "eq": [{ "ref": "item.name" }, "Health Potion"] } } }, 0] }
        ]
      },
      "actions": [
        { "action": "use", "item": { "select": "bag", "where": { "eq": [{ "ref": "item.name" }, "Health Potion"] } } }
      ]
    },
    {
      "id": "flee",
      "priority": 90,
      "condition": { "lt": [{ "ref": "self.health_pct" }, 15] },
      "actions": [{ "intent": "flee" }]
    },
    {
      "id": "hunt-slimes",
      "priority": 10,
      "condition": { "gt": [{ "count": { "select": "monsters", "where": { "eq": [{ "ref": "monster.name" }, "Slime"] } } }, 0] },
      "actions": [
        { "action": "attack", "target": { "select": "monsters", "where": { "eq": [{ "ref": "monster.name" }, "Slime"] }, "order": "nearest" } }
      ]
    },
    {
      "id": "patrol",
      "priority": 0,
      "condition": { "eq": [true, true] },
      "actions": [{ "intent": "patrol" }]
    }
  ]
}
