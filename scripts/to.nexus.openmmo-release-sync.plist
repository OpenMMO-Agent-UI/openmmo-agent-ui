<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Template: launchd needs literal absolute paths (no $HOME/env expansion),
  so substitute /path/to/openmmo-agent-ui below with this checkout's actual
  absolute path before `launchctl load`ing this file, e.g.:
    sed "s#/path/to/openmmo-agent-ui#$(pwd)#g" scripts/to.nexus.openmmo-release-sync.plist \
      > ~/Library/LaunchAgents/to.nexus.openmmo-release-sync.plist
-->
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>to.nexus.openmmo-release-sync</string>
	<key>ProgramArguments</key>
	<array>
		<string>/path/to/openmmo-agent-ui/scripts/release-sync-cron.sh</string>
	</array>
	<key>StartInterval</key>
	<integer>28800</integer>
	<key>RunAtLoad</key>
	<false/>
	<key>StandardOutPath</key>
	<string>/path/to/openmmo-agent-ui/.release-sync.log</string>
	<key>StandardErrorPath</key>
	<string>/path/to/openmmo-agent-ui/.release-sync.log</string>
</dict>
</plist>
