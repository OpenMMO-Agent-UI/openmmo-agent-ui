        <mxCell id="lgt4" value="Local process or data" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;" vertex="1" parent="legend"><mxGeometry x="702" y="32" width="130" height="20" as="geometry"/></mxCell>
        <mxCell id="lg5" value="" style="rounded=0;html=1;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="legend"><mxGeometry x="834" y="34" width="26" height="16" as="geometry"/></mxCell>
        <mxCell id="lgt5" value="External service" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;" vertex="1" parent="legend"><mxGeometry x="866" y="32" width="130" height="20" as="geometry"/></mxCell>
        <mxCell id="lg6" value="" style="rounded=0;html=1;fillColor=#f0f0f0;strokeColor=#aaaaaa;" vertex="1" parent="legend"><mxGeometry x="998" y="34" width="26" height="16" as="geometry"/></mxCell>
        <mxCell id="lgt6" value="Off in this build" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;" vertex="1" parent="legend"><mxGeometry x="1030" y="32" width="130" height="20" as="geometry"/></mxCell>
        <mxCell id="note" value="&lt;b&gt;What actually drives Automatic play.&lt;/b&gt; The server permits exactly one controlling session per character, and in this build that session is driven by the &lt;b&gt;rule-based Monster Fighter inside agent-client&lt;/b&gt; — hunting, looting and restocking from the &lt;code&gt;[npcs.worker]&lt;/code&gt; block configToml.js writes, with no LLM in the loop. The model agent is still wired up (LLM tab, llmValidation.js, the Thoughts panel) but settingsStore.js reads every workerKind back as &lt;code&gt;fighter&lt;/code&gt;, so nothing can select it; translate.js is the one live caller left of an LLM backend. &lt;b&gt;Automatic&lt;/b&gt; — main.js brings proxy.js up on loopback, then agent.js spawns agent-client pointed at the relay instead of the real server; the relay forwards byte for byte and tees every frame to /mirror, so the spectator scene in the iframe watches without taking a second session. &lt;b&gt;Manual&lt;/b&gt; — no relay and no agent-client: server.js hands the iframe the real web client, which dials the game server itself under your own Google session." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#444444;spacingLeft=4;" vertex="1" parent="1"><mxGeometry x="1300" y="2120" width="1100" height="110" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
