<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="drawio" version="26.0.0">
  <diagram name="Components" id="components">
    <mxGraphModel dx="2500" dy="1700" grid="1" gridSize="10" page="1" pageWidth="2460" pageHeight="2240" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" value="&lt;b&gt;OpenMMO Agent UI — component architecture&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=23;" vertex="1" parent="1"><mxGeometry x="60" y="24" width="1500" height="34" as="geometry"/></mxCell>
        <mxCell id="sub" value="Electron desktop client v0.39.0 — the renderer panel, main-process orchestration, the agent relay, and everything each one talks to." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontColor=#666666;" vertex="1" parent="1"><mxGeometry x="60" y="60" width="1700" height="24" as="geometry"/></mxCell>
        <mxCell id="bandR" value="Renderer process — src/renderer/ + src/workflow.js  ·  plain HTML/CSS/ES modules, no build step" style="swimlane;html=1;whiteSpace=wrap;rounded=1;arcSize=2;startSize=40;fillColor=#dae8fc;strokeColor=#6c8ebf;swimlaneFillColor=#f6faff;fontStyle=1;fontSize=15;align=left;spacingLeft=16;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="60" y="110" width="2100" height="410" as="geometry"/></mxCell>
        <mxCell id="app" value="&lt;b&gt;app.js&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;color:#4d4d4d&quot;&gt;state owner &amp;amp; coordinator —&lt;br&gt;settings, play status, feed, vitals;&lt;br&gt;owns every panel module beside it&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;verticalAlign=middle;fontSize=14;" vertex="1" parent="bandR"><mxGeometry x="20" y="60" width="340" height="295" as="geometry"/></mxCell>
        <mxCell id="signin" value="&lt;b&gt;signInFlow.js&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;color:#4d4d4d&quot;&gt;sign-in, connection profiles, character roster&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;verticalAlign=middle;" vertex="1" parent="bandR"><mxGeometry x="390" y="60" width="230" height="85" as="geometry"/></mxCell>
        <mxCell id="setpanel" value="&lt;b&gt;settingsPanel.js&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;color:#4d4d4d&quot;&gt;LLM / cadence / display Settings tabs&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;verticalAlign=middle;" vertex="1" parent="bandR"><mxGeometry x="640" y="60" width="230" height="85" as="geometry"/></mxCell>
        <mxCell id="bagworn" value="&lt;b&gt;bagWorn.js&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;color:#4d4d4d&quot;&gt;worn + bag drawers, sellable / dropable labels&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;verticalAlign=middle;" vertex="1" parent="bandR"><mxGeometry x="890" y="60" width="230" height="85" as="geometry"/></mxCell>
        <mxCell id="toasts" value="&lt;b&gt;actionToasts.js&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;color:#4d4d4d&quot;&gt;action-toast feed over the game view&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;verticalAlign=middle;" vertex="1" parent="bandR"><mxGeometry x="390" y="165" width="230" height="85" as="geometry"/></mxCell>
        <mxCell id="workflow" value="&lt;b&gt;workflow.js&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;color:#4d4d4d&quot;&gt;Server → Login → Character → Game screens&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;verticalAlign=middle;" vertex="1" parent="bandR"><mxGeometry x="640" y="165" width="230" height="85" as="geometry"/></mxCell>
        <mxCell id="duty" value="&lt;b&gt;duty.js&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;color:#4d4d4d&quot;&gt;one vocabulary for the header status word&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;verticalAlign=middle;" vertex="1" parent="bandR"><mxGeometry x="890" y="165" width="230" height="85" as="geometry"/></mxCell>
        <mxCell id="banner" value="&lt;b&gt;updateBanner.js&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;color:#4d4d4d&quot;&gt;update-banner wording and buttons&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;verticalAlign=middle;" vertex="1" parent="bandR"><mxGeometry x="390" y="270" width="230" height="85" as="geometry"/></mxCell>
        <mxCell id="dom" value="&lt;b&gt;dom.js  ·  i18n.js&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;color:#4d4d4d&quot;&gt;shared DOM helpers, ko / zh-TW dictionaries&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;verticalAlign=middle;" vertex="1" parent="bandR"><mxGeometry x="640" y="270" width="230" height="85" as="geometry"/></mxCell>
        <mxCell id="hunt" value="&lt;b&gt;Monster Fighter drawer&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;color:#4d4d4d&quot;&gt;the fighter&amp;#39;s own knobs, live beside the view —&lt;br&gt;app.js renderHunt() + index.html&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;verticalAlign=middle;" vertex="1" parent="bandR"><mxGeometry x="890" y="270" width="230" height="85" as="geometry"/></mxCell>
        <mxCell id="iframe" value="&lt;b&gt;iframe #frame — the game view&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;color:#4d4d4d&quot;&gt;Automatic → the spectator scene (read-only mirror)&lt;br&gt;Manual → the real OpenMMO web client&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=13;verticalAlign=middle;fontSize=14;" vertex="1" parent="bandR"><mxGeometry x="1240" y="60" width="720" height="190" as="geometry"/></mxCell>
        <mxCell id="bandP" value="&lt;b&gt;preload.js — contextBridge &lt;code&gt;agentApp&lt;/code&gt;&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;color:#4d4d4d&quot;&gt;the renderer&amp;#39;s only surface: ipcRenderer.invoke(&amp;hellip;) out, main → renderer events back&lt;/font&gt;" style="rounded=1;arcSize=6;html=1;whiteSpace=wrap;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=15;align=left;spacingLeft=16;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="60" y="560" width="1160" height="80" as="geometry"/></mxCell>
        <mxCell id="bandM" value="Electron main process — src/  ·  Node" style="swimlane;html=1;whiteSpace=wrap;rounded=1;arcSize=2;startSize=40;fillColor=#ffe6cc;strokeColor=#d79b00;swimlaneFillColor=#fffaf3;fontStyle=1;fontSize=15;align=left;spacingLeft=16;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="60" y="690" width="2100" height="760" as="geometry"/></mxCell>
        <mxCell id="main" value="&lt;b&gt;main.js&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;color:#4d4d4d&quot;&gt;IPC hub · sign-in and play orchestration · feed / vitals polling&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=13;verticalAlign=middle;fontSize=14;" vertex="1" parent="bandM"><mxGeometry x="20" y="60" width="520" height="130" as="geometry"/></mxCell>
        <mxCell id="play" value="&lt;b&gt;playSession.js&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;color:#4d4d4d&quot;&gt;Automatic ⇄ Manual state machine — picks a mode, retries a dropped session with backoff, switches live&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=13;verticalAlign=middle;fontSize=14;" vertex="1" parent="bandM"><mxGeometry x="640" y="60" width="520" height="130" as="geometry"/></mxCell>
        <mxCell id="subCfg" value="Session, settings &amp;amp; identity" style="swimlane;html=1;whiteSpace=wrap;rounded=1;arcSize=3;startSize=32;fillColor=#ffd9a8;strokeColor=#d79b00;swimlaneFillColor=#fff8f0;fontStyle=0;fontSize=13;align=left;spacingLeft=12;verticalAlign=middle;" vertex="1" parent="bandM"><mxGeometry x="20" y="230" width="560" height="470" as="geometry"/></mxCell>
        <mxCell id="settings" value="&lt;b&gt;settingsStore.js&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;color:#4d4d4d&quot;&gt;persistence, secrets, validation, fighter knobs&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=13;verticalAlign=middle;" vertex="1" parent="subCfg"><mxGeometry x="20" y="50" width="250" height="90" as="geometry"/></mxCell>
        <mxCell id="profiles" value="&lt;b&gt;connectionProfiles.js&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;color:#4d4d4d&quot;&gt;server / terrain / Google-client profiles&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=13;verticalAlign=middle;" vertex="1" parent="subCfg"><mxGeometry x="290" y="50" width="250" height="90" as="geometry"/></mxCell>
        <mxCell id="gauth" value="&lt;b&gt;googleAuth.js&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;color:#4d4d4d&quot;&gt;device-flow sign-in, cache shared with the agent&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=13;verticalAlign=middle;" vertex="1" parent="subCfg"><mxGeometry x="20" y="155" width="250" height="90" as="geometry"/></mxCell>
        <mxCell id="llmval" value="&lt;b&gt;llmValidation.js&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;color:#4d4d4d&quot;&gt;checks backend / model / key before Automatic&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=13;verticalAlign=middle;" vertex="1" parent="subCfg"><mxGeometry x="290" y="155" width="250" height="90" as="geometry"/></mxCell>
        <mxCell id="cfgtoml" value="&lt;b&gt;configToml.js&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;color:#4d4d4d&quot;&gt;settings → data/config.toml, incl. [npcs.worker]&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=13;verticalAlign=middle;" vertex="1" parent="subCfg"><mxGeometry x="20" y="260" width="250" height="90" as="geometry"/></mxCell>
        <mxCell id="persona" value="&lt;b&gt;personalityText.js&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;color:#4d4d4d&quot;&gt;per-character prompt + memory paths&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=13;verticalAlign=middle;" vertex="1" parent="subCfg"><mxGeometry x="290" y="260" width="250" height="90" as="geometry"/></mxCell>
        <mxCell id="charstore" value="&lt;b&gt;characterStore.js&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;color:#4d4d4d&quot;&gt;per-character JSON: labels, coords, presets&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=13;verticalAlign=middle;" vertex="1" parent="subCfg"><mxGeometry x="20" y="365" width="250" height="90" as="geometry"/></mxCell>
        <mxCell id="backends" value="&lt;b&gt;backends.js&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;color:#4d4d4d&quot;&gt;the backend / model table, three readers&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=13;verticalAlign=middle;" vertex="1" parent="subCfg"><mxGeometry x="290" y="365" width="250" height="90" as="geometry"/></mxCell>
        <mxCell id="subPlat" value="Platform &amp;amp; support" style="swimlane;html=1;whiteSpace=wrap;rounded=1;arcSize=3;startSize=32;fillColor=#ffd9a8;strokeColor=#d79b00;swimlaneFillColor=#fff8f0;fontStyle=0;fontSize=13;align=left;spacingLeft=12;verticalAlign=middle;" vertex="1" parent="bandM"><mxGeometry x="640" y="230" width="520" height="470" as="geometry"/></mxCell>
        <mxCell id="runtime" value="&lt;b&gt;runtimeEnv.js&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;color:#4d4d4d&quot;&gt;dev vs packaged paths, protocol version&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=13;verticalAlign=middle;" vertex="1" parent="subPlat"><mxGeometry x="20" y="50" width="230" height="90" as="geometry"/></mxCell>
        <mxCell id="seed" value="&lt;b&gt;seedSync.js&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;color:#4d4d4d&quot;&gt;replace untouched seeds, keep hand edits&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=13;verticalAlign=middle;" vertex="1" parent="subPlat"><mxGeometry x="270" y="50" width="230" height="90" as="geometry"/></mxCell>
        <mxCell id="i18nm" value="&lt;b&gt;i18n.js  ·  appPaths.js&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;color:#4d4d4d&quot;&gt;main-process catalogue + path helpers&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=13;verticalAlign=middle;" vertex="1" parent="subPlat"><mxGeometry x="20" y="155" width="230" height="90" as="geometry"/></mxCell>
        <mxCell id="translate" value="&lt;b&gt;translate.js&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;color:#4d4d4d&quot;&gt;live chat translation via the HTTP backend&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=13;verticalAlign=middle;" vertex="1" parent="subPlat"><mxGeometry x="270" y="155" width="230" height="90" as="geometry"/></mxCell>
        <mxCell id="telemetry" value="&lt;b&gt;telemetry.js&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;color:#4d4d4d&quot;&gt;anonymous Aptabase counters&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=13;verticalAlign=middle;" vertex="1" parent="subPlat"><mxGeometry x="20" y="260" width="230" height="90" as="geometry"/></mxCell>
        <mxCell id="updater" value="&lt;b&gt;updater.js&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;color:#4d4d4d&quot;&gt;electron-updater check / install&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=13;verticalAlign=middle;" vertex="1" parent="subPlat"><mxGeometry x="270" y="260" width="230" height="90" as="geometry"/></mxCell>
        <mxCell id="toml" value="&lt;b&gt;toml.js&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;color:#4d4d4d&quot;&gt;just enough TOML to import a config&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=13;verticalAlign=middle;" vertex="1" parent="subPlat"><mxGeometry x="20" y="365" width="230" height="90" as="geometry"/></mxCell>
        <mxCell id="msgpack" value="&lt;b&gt;msgpack.js&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;color:#4d4d4d&quot;&gt;the wire codec rmp_serde speaks&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=13;verticalAlign=middle;" vertex="1" parent="subPlat"><mxGeometry x="270" y="365" width="230" height="90" as="geometry"/></mxCell>
        <mxCell id="subPlay" value="Play &amp;amp; relay" style="swimlane;html=1;whiteSpace=wrap;rounded=1;arcSize=3;startSize=32;fillColor=#ffd9a8;strokeColor=#d79b00;swimlaneFillColor=#fff8f0;fontStyle=0;fontSize=13;align=left;spacingLeft=12;verticalAlign=middle;" vertex="1" parent="bandM"><mxGeometry x="1280" y="230" width="680" height="470" as="geometry"/></mxCell>
        <mxCell id="agentjs" value="&lt;b&gt;agent.js&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;color:#4d4d4d&quot;&gt;resolves + spawns the agent-client binary,&lt;br&gt;streams its logs, detects protocol mismatches&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=13;verticalAlign=middle;" vertex="1" parent="subPlay"><mxGeometry x="20" y="55" width="290" height="150" as="geometry"/></mxCell>
        <mxCell id="charsess" value="&lt;b&gt;characterSession.js&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;color:#4d4d4d&quot;&gt;pre-flight sign-in and character CRUD&lt;br&gt;over its own socket, bypassing agent-client&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=13;verticalAlign=middle;" vertex="1" parent="subPlay"><mxGeometry x="370" y="55" width="290" height="150" as="geometry"/></mxCell>
        <mxCell id="serverjs" value="&lt;b&gt;server.js&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;color:#4d4d4d&quot;&gt;serves client/dist and proxies /api plus&lt;br&gt;any missing or LFS-pointer asset&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=13;verticalAlign=middle;" vertex="1" parent="subPlay"><mxGeometry x="20" y="245" width="290" height="150" as="geometry"/></mxCell>
        <mxCell id="proxyjs" value="&lt;b&gt;proxy.js&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;color:#4d4d4d&quot;&gt;agent ⇄ server relay on loopback, byte for&lt;br&gt;byte, started before the agent — and the&lt;br&gt;read-only spectator mirror it tees to&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=13;verticalAlign=middle;" vertex="1" parent="subPlay"><mxGeometry x="370" y="245" width="290" height="150" as="geometry"/></mxCell>
        <mxCell id="bandL" value="Local processes &amp;amp; on-disk data" style="swimlane;html=1;whiteSpace=wrap;rounded=1;arcSize=2;startSize=40;fillColor=#d5e8d4;strokeColor=#82b366;swimlaneFillColor=#f7fcf5;fontStyle=1;fontSize=15;align=left;spacingLeft=16;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="60" y="1530" width="2100" height="250" as="geometry"/></mxCell>
        <mxCell id="userdata" value="&lt;b&gt;userData/&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;color:#4d4d4d&quot;&gt;settings.json · API keys and profile secrets encrypted&lt;br&gt;with the OS keychain (safeStorage, AES-GCM fallback)&lt;br&gt;· Google credential cache · terrain asset cache&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=13;verticalAlign=middle;" vertex="1" parent="bandL"><mxGeometry x="20" y="60" width="340" height="160" as="geometry"/></mxCell>
        <mxCell id="cfgfiles" value="&lt;b&gt;agent-client/data/  ·  overlay/&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;color:#4d4d4d&quot;&gt;config.toml, regenerated from the panel on every start&lt;br&gt;and never holding a credential · desktop-owned&lt;br&gt;prompts, memory and per-character stores&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=13;verticalAlign=middle;" vertex="1" parent="bandL"><mxGeometry x="410" y="60" width="340" height="160" as="geometry"/></mxCell>
        <mxCell id="clientdist" value="&lt;b&gt;client/dist&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;color:#4d4d4d&quot;&gt;the built OpenMMO web client (wasm),&lt;br&gt;pinned at deps/OpenMMO — serves both&lt;br&gt;the spectator scene and Manual play&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=13;verticalAlign=middle;" vertex="1" parent="bandL"><mxGeometry x="800" y="60" width="340" height="160" as="geometry"/></mxCell>
        <mxCell id="agentclient" value="&lt;b&gt;agent-client  &lt;i&gt;(child process)&lt;/i&gt;&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;color:#4d4d4d&quot;&gt;the official binary at zero modifications — holds the one controlling session and exposes a JSON watch API on 127.0.0.1&lt;/font&gt;" style="swimlane;html=1;whiteSpace=wrap;rounded=1;arcSize=3;startSize=58;fillColor=#bcd9b4;strokeColor=#82b366;swimlaneFillColor=#f2f9ef;fontStyle=0;fontSize=13;align=left;spacingLeft=12;verticalAlign=middle;" vertex="1" parent="bandL"><mxGeometry x="1280" y="60" width="680" height="172" as="geometry"/></mxCell>
        <mxCell id="fighter" value="&lt;b&gt;Monster Fighter — the rule worker&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;color:#4d4d4d&quot;&gt;&lt;b&gt;what actually drives Automatic play.&lt;/b&gt; Hunts the nearest&lt;br&gt;monster it can beat, loots the kill, restocks in town.&lt;br&gt;Rules only: no LLM, no API key, no prompt&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=13;verticalAlign=middle;strokeWidth=2;" vertex="1" parent="agentclient"><mxGeometry x="20" y="66" width="400" height="92" as="geometry"/></mxCell>
