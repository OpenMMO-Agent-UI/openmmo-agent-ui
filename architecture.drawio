        <mxCell id="lg0" value="" style="rounded=0;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="legend"><mxGeometry x="14" y="34" width="26" height="16" as="geometry"/></mxCell>
